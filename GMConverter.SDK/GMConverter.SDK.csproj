<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <AssemblyName>GMConverter.SDK</AssemblyName>
        <PackageId>GMConverter.SDK</PackageId>
        <RootNamespace>GMConverter.SDK</RootNamespace>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
        <!-- Logging.Abstractions is a no-runtime-dep package; safe in the SDK because plugins need
             ILoggerFactory to write into the host's logging configuration. -->
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.0" />
    </ItemGroup>

</Project>
