<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    </PropertyGroup>

    <ItemGroup>
        <AvaloniaResource Include="Assets\**"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Ab4d.SharpEngine" Version="4.0.9594" />
        <PackageReference Include="Ab4d.SharpEngine.AvaloniaUI" Version="4.0.9594" />
        <PackageReference Include="Ab4d.SharpEngine.glTF" Version="4.0.9594" />
        <PackageReference Include="Avalonia" Version="12.0.3"/>
        <PackageReference Include="Avalonia.Desktop" Version="12.0.3"/>
        <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.1">
            <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
            <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
        </PackageReference>
        <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.1"/>
        <PackageReference Include="Jab" Version="0.12.0" />
        <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.0" />
        <PackageReference Include="ShadUI" Version="0.2.3" />
        <PackageReference Include="Svg.Controls.Skia.Avalonia" Version="12.0.0.6" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\GMConverter\GMConverter.csproj" />
    </ItemGroup>

    <!-- Plugins bundled with this host build. See GMConverter.CLI.csproj for the rationale. -->
    <ItemGroup>
        <BundledPlugin Include="..\GMConverter.SourceEngine\GMConverter.SourceEngine.csproj">
            <PluginId>sourceengine</PluginId>
        </BundledPlugin>
        <BundledPlugin Include="..\GMConverter.UnrealEngine\GMConverter.UnrealEngine.csproj">
            <PluginId>unrealengine</PluginId>
        </BundledPlugin>
        <BundledPlugin Include="..\GMConverter.MenOfWar\GMConverter.MenOfWar.csproj">
            <PluginId>menofwar</PluginId>
        </BundledPlugin>
        <BundledPlugin Include="..\GMConverter.XWingAlliance\GMConverter.XWingAlliance.csproj">
            <PluginId>xwingalliance</PluginId>
        </BundledPlugin>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="@(BundledPlugin)">
            <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
            <Private>false</Private>
        </ProjectReference>
    </ItemGroup>

    <Target Name="CopyBundledPlugins" AfterTargets="Build">
        <ItemGroup>
            <PluginPayload Include="%(BundledPlugin.RootDir)%(BundledPlugin.Directory)bin\$(Configuration)\$(TargetFramework)\**\*"
                           PluginId="%(BundledPlugin.PluginId)" />
        </ItemGroup>
        <Copy SourceFiles="@(PluginPayload)"
              DestinationFiles="$(OutputPath)plugins\%(PluginPayload.PluginId)\%(PluginPayload.RecursiveDir)%(PluginPayload.Filename)%(PluginPayload.Extension)"
              SkipUnchangedFiles="true" />
    </Target>

  <!-- Plugin payloads are external runtime files, including for single-file hosts. -->
  <Target Name="IncludeBundledPluginsInPublish" AfterTargets="ComputeFilesToPublish"
          DependsOnTargets="CopyBundledPlugins">
      <ItemGroup>
          <PublishPluginPayload Include="$(OutputPath)plugins\**\*" />
          <ResolvedFileToPublish Include="@(PublishPluginPayload)">
              <RelativePath>plugins\%(PublishPluginPayload.RecursiveDir)%(PublishPluginPayload.Filename)%(PublishPluginPayload.Extension)</RelativePath>
              <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
              <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
          </ResolvedFileToPublish>
      </ItemGroup>
  </Target>

    <ItemGroup>
      <Compile Update="Controls\Preview\PreviewSidebar.axaml.cs">
        <DependentUpon>PreviewSidebar.axaml</DependentUpon>
        <SubType>Code</SubType>
      </Compile>
      <Compile Update="Controls\Sidebar.axaml.cs">
        <DependentUpon>Sidebar.axaml</DependentUpon>
        <SubType>Code</SubType>
      </Compile>
      <Compile Update="Controls\Header.axaml.cs">
        <DependentUpon>Header.axaml</DependentUpon>
        <SubType>Code</SubType>
      </Compile>
      <Compile Update="Controls\ScrollProgress.axaml.cs">
        <DependentUpon>ScrollProgress.axaml</DependentUpon>
        <SubType>Code</SubType>
      </Compile>
      <Compile Update="Views\MainWindow.axaml.cs">
        <DependentUpon>MainWindow.axaml</DependentUpon>
        <SubType>Code</SubType>
      </Compile>
    </ItemGroup>
</Project>
