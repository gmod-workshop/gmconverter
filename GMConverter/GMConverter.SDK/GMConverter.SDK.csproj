<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <AssemblyName>GMConverter.SDK</AssemblyName>
        <PackageId>GMConverter.SDK</PackageId>
        <RootNamespace>GMConverter.SDK</RootNamespace>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
        <!-- DependencyInjection.Abstractions exposes IServiceProvider on IPluginContext. Plugins
             pull ITextureFactory, ILoggerFactory, and any future host services via DI rather than
             named context properties. Abstractions has no runtime dependencies. -->
        <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.0" />
        <!-- Logging.Abstractions is pulled transitively but listed explicitly so plugins that need
             ILogger types don't depend on a transitive that could be tightened later. -->
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.0" />
    </ItemGroup>

</Project>
