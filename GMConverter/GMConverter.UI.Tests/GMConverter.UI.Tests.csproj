<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Headless.XUnit" Version="12.0.3" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GMConverter.UI\GMConverter.UI.csproj" />
    <ProjectReference Include="..\GMConverter.CLI\GMConverter.CLI.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- PSK fixture writers shared with the Unreal Engine plugin tests. -->
    <Compile Include="..\..\Plugins\GMConverter.UnrealEngine.Tests\PskFixtures.cs" Link="PskFixtures.cs" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>